{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "ApiKey": "",
    "Username": "",
    "Password": "",
    "SourceIndex": "telemetry-*",
    "AnomalyResultsIndex": "ai-anomalies-*",
    "EvidenceWindowMinutes": 15,
    "EvidenceSizeLimit": 100
  },
  "Kibana": {
    "Url": "http://localhost:5601",
    "ApiKey": "",
    "Space": "default",
    "DataViewName": "Telemetry",
    "DataViewId": "telemetry-view",
    "ResultsDataViewName": "AI Anomalies",
    "ResultsDataViewId": "ai-anomalies-view",
    "DashboardTitle": "Anomaly RCA Dashboard",
    "DashboardId": "anomaly-rca-dashboard"
  },
  "SourceFields": {
    "Timestamp": "@timestamp",
    "Service": "service.name",
    "Environment": "service.environment",
    "Duration": "event.duration",
    "StatusCode": "http.response.status_code",
    "Route": "url.path",
    "Message": "message",
    "Exception": "error.message",
    "TraceId": "trace.id",
    "AdditionalFields": []
  },
  "AnomalyDetection": {
    "JobId": "app-anomaly-job",
    "DatafeedId": "datafeed-app-anomaly-job",
    "BucketSpan": "15m",
    "Influencers": [
      "service.name",
      "service.environment"
    ],
    "Detectors": [
      {
        "Id": "high-latency",
        "Description": "high latency",
        "Function": "high_mean",
        "FieldName": "event.duration",
        "ByFieldName": "service.name",
        "OverFieldName": null,
        "PartitionFieldName": "service.environment"
      },
      {
        "Id": "high-error-rate",
        "Description": "high error rate",
        "Function": "high_count",
        "FieldName": "http.response.status_code",
        "ByFieldName": "service.name",
        "OverFieldName": null,
        "PartitionFieldName": "service.environment"
      }
    ]
  },
  "Foundry": {
    "ProjectEndpoint": "https://<resource>.services.ai.azure.com/api/projects/<project>",
    "AgentName": "anomaly-rca-agent",
    "TimeoutSeconds": 60
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "anomaly",
    "Password": "anomaly123",
    "VirtualHost": "/",
    "Exchange": "anomaly.events",
    "Queue": "anomaly-investigation",
    "RoutingKey": "anomaly.detected",
    "DeadLetterQueue": "anomaly-investigation.dlq",
    "PrefetchCount": 10,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5
  }
}
